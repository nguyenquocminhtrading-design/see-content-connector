# =================================================================
# SEE CONTENT CONNECTOR — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server & App Settings
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
ENCRYPTION_KEY=your_32_byte_secret_key_for_aes256_here_!!

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=see_content_connector

# Cache & BullMQ Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# =================================================================
# 1. META GRAPH API (Facebook Pages & Instagram Professional)
# =================================================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_facebook_page_id
# Never-expiring Long-lived Page Access Token from Meta System User / Extended Token
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
# Instagram Business Account ID (retrieved via GET /{page_id}?fields=instagram_business_account)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# =================================================================
# 2. TIKTOK CONTENT & DISPLAY API
# =================================================================
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:4000/api/auth/tiktok/callback

# =================================================================
# 3. LINKEDIN REST API (Community Management / Posts)
# =================================================================
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_company_id
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/auth/linkedin/callback

# =================================================================
# SYNC WORKER SETTINGS
# =================================================================
# Interval in minutes for polling social platforms
SYNC_INTERVAL_MINUTES=15
