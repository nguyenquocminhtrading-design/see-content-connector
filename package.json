{
  "name": "see-content-connector",
  "version": "1.0.0",
  "private": true,
  "description": "SEE Content Connector - multi-platform content dashboard (Facebook / Instagram / LinkedIn / TikTok)",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
